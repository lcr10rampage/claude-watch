# Copy to .env and fill in:  cp .env.example .env
# Make a random token with:  python3 -c "import secrets; print(secrets.token_hex(16))"
WATCH_TOKEN=change-me
WATCH_PORT=8787
CLAUDE_TIMEOUT=90

# Connections Claude may use without asking. Add one each time you connect
# a new API (use the name you gave it in `claude mcp add`).
CLAUDE_ALLOWED_TOOLS=mcp__google-calendar,mcp__watch-tools
