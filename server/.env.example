# Copy to .env and fill in:  cp .env.example .env
# Make a random token with:  python3 -c "import secrets; print(secrets.token_hex(16))"
WATCH_TOKEN=change-me
WATCH_PORT=8787
WATCH_TZ=America/New_York
CLAUDE_TIMEOUT=90

# Connections Claude may use without asking. watch-tools covers Gmail,
# Calendar, Sheets, reminders, weather, and notes. Add more, comma-separated,
# if you connect other MCP servers with `claude mcp add`.
CLAUDE_ALLOWED_TOOLS=mcp__watch-tools,mcp__claude_ai_Google_Calendar,mcp__claude_ai_Gmail,WebSearch,WebFetch

# Voice questions (POST /ask-voice). faster-whisper lives in ~/stt-env; run the server with
# ~/stt-env/bin/python (see claude-watch.service). tiny.en is fast, base.en more accurate.
STT_MODEL=tiny.en
STT_PROMPT=Claude, Luke.
STT_BEAM=3
STT_MIN_LOGPROB=-0.9
STT_SILENCE_DBFS=-45
