# Copy to .env and fill in:  cp .env.example .env
# Make a random token with:  python3 -c "import secrets; print(secrets.token_hex(16))"
WATCH_TOKEN=change-me
WATCH_PORT=8787
WATCH_TZ=America/New_York
CLAUDE_TIMEOUT=90

# Connections Claude may use without asking. watch-tools covers Gmail,
# Calendar, Sheets, reminders, weather, and notes. Add more, comma-separated,
# if you connect other MCP servers with `claude mcp add`.
CLAUDE_ALLOWED_TOOLS=mcp__watch-tools
