# Runs the server automatically when the Pi boots.
# Install (edit User and paths first if your username isn't "pi"):
#   sudo cp claude-watch.service /etc/systemd/system/
#   sudo systemctl enable --now claude-watch
#   journalctl -u claude-watch -f     # watch the logs

[Unit]
Description=Claude Watch server
After=network-online.target
Wants=network-online.target

[Service]
User=lcr10rampage
WorkingDirectory=/home/lcr10rampage/claude-watch/server
EnvironmentFile=/home/lcr10rampage/claude-watch/server/.env
Environment=PATH=/home/lcr10rampage/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/lcr10rampage/stt-env/bin/python /home/lcr10rampage/claude-watch/server/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
