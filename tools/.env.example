# Settings and API keys for your tools. Copy to .env:  cp .env.example .env

# Your budget spreadsheet: copy the long ID from its URL,
# docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_BUDGET=
# The tab Claude adds expenses to (exact name, e.g. Expenses). Leave blank for the first tab.
SHEET_BUDGET_TAB=

# Optional second spreadsheet for logging hours, job applications, etc.
SHEET_LOG=
SHEET_LOG_TAB=

WATCH_TZ=America/New_York

# Keys for future APIs go here, e.g.
# MY_API_KEY=...
